# Copy this file to .env and fill in the values.

# SerpAPI key (https://serpapi.com/). Alternatively, set GOOGLE_PLACES_API_KEY if you implement that extractor.
SERPAPI_API_KEY=your_serpapi_key_here

# OpenAI API Key (or other LLM provider key)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Sheets service account JSON path and spreadsheet id.
GOOGLE_SHEETS_CREDENTIALS_JSON=./credentials.json
SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Fallback: store results to CSV instead of Google Sheets (true/false)
USE_CSV=true
CSV_OUTPUT_PATH=leads_output.csv

# Pipeline config
RESULTS_PAGE_SIZE=10

